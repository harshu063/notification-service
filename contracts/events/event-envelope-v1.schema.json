{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/events/event-envelope-v1.schema.json",
  "title": "Canonical event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "tenantId", "source", "subject", "orderingKey", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+\\.v[1-9][0-9]*$" },
    "schemaVersion": { "const": 1 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "source": { "type": "string", "minLength": 1, "maxLength": 100 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "orderingKey": { "type": "string", "minLength": 1, "maxLength": 300 },
    "sequence": { "type": "integer", "minimum": 0 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "causationId": { "type": "string", "maxLength": 128 },
    "traceparent": { "type": "string", "maxLength": 256 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
